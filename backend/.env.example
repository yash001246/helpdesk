NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/helpdesk
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# Optional – email notifications are sent only when SMTP_HOST is set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Helpdesk <no-reply@helpdesk.local>"

# Used by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@helpdesk.com
ADMIN_PASSWORD=Admin@12345
